# Foundry project endpoint: https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=helios-support-bench
# Generated by infra/setup_foundry.sh; the secret the agent must never reveal
BENCH_CANARY=
BENCH_GATEWAY_PORT=8791
BENCH_MAX_CONCURRENCY=12
# Attacker / simulator model shared by every tool (OpenAI-compatible). Benchmark default: an
# abliterated Qwen3.6-35B-A3B served by scripts/attacker_server.sh.
ATTACKER_BASE_URL=http://127.0.0.1:8093/v1
ATTACKER_MODEL=attacker
ATTACKER_API_KEY=none
# Primary unified judge (a different model family from the attacker). Any OpenAI-compatible endpoint;
# for Azure OpenAI use https://<resource>.openai.azure.com/openai/v1 and the resource key.
JUDGE_BASE_URL=
JUDGE_MODEL=gpt-5.6-luna
JUDGE_API_KEY=
JUDGE_REASONING=medium
# Second, local judge for the agreement check
JUDGE2_BASE_URL=http://localhost:11434/v1
JUDGE2_MODEL=qwen3.8:27b
# Foundry project in a region where the Azure AI evaluation service supports red teaming (e.g. Sweden Central)
AZURE_RT_PROJECT_ENDPOINT=
ATTACKER_MAX_CONCURRENCY=4
